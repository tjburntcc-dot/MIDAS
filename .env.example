# MIDAS local configuration.
# Copy to .env and fill in real values. .env is git-ignored and must never be committed.
# The project .env takes precedence over any machine-wide environment variable of the
# same name, so a stale system key cannot silently override the project key.

# ── OpenAI: required for live employee reasoning and embeddings ──────────────
OPENAI_API_KEY=
# Chat/reasoning model used by specialists. Default: gpt-4.1
OPENAI_MODEL=gpt-4.1
# Cheaper model used to turn a source into lessons. Default: gpt-4.1-mini
MIDAS_EXTRACTION_MODEL=gpt-4.1-mini

# ── Google Gemini: optional, enables watching a public YouTube URL ───────────
# Without this, YouTube sources still work if you paste the transcript.
GEMINI_API_KEY=
# Documented fallback variable name; used only if GEMINI_API_KEY is empty.
GOOGLE_API_KEY=

# ── Tavily: optional, enables bounded web search ─────────────────────────────
# Not required to learn from a URL you supply yourself.
TAVILY_API_KEY=
