{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midas.local/schemas/atlas-task-input-v0.json",
  "title": "Atlas prospect qualification runtime input v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "title", "offer", "qualification_policy", "constraints", "prospects"],
  "properties": {
    "case_id": { "type": "string", "pattern": "^ATLAS-(DEV|SEALED)-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 8 },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "price_usd", "billing_period", "sales_motion"],
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "summary": { "type": "string", "minLength": 12 },
        "price_usd": { "type": "number", "minimum": 0 },
        "billing_period": { "enum": ["month", "one_time", "year"] },
        "sales_motion": { "enum": ["founder_led", "self_serve", "sales_assisted"] }
      }
    },
    "qualification_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "preferred", "disqualifiers", "unknown_policy"],
      "properties": {
        "required": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 4 } },
        "preferred": { "type": "array", "items": { "type": "string", "minLength": 4 } },
        "disqualifiers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 4 } },
        "unknown_policy": { "const": "mandatory_unknown_requires_research" }
      }
    },
    "constraints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } },
    "prospects": {
      "type": "array",
      "minItems": 4,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "company", "facts", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^P[0-9]{1,2}$" },
          "company": { "type": "string", "minLength": 2 },
          "facts": { "type": "object" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "claim", "source", "age_days"],
              "properties": {
                "id": { "type": "string", "pattern": "^E[0-9]{1,2}$" },
                "claim": { "type": "string", "minLength": 8 },
                "source": { "enum": ["first_party", "official", "third_party", "unverified", "prospect_supplied"] },
                "age_days": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
