{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midas.local/schemas/atlas-evaluator-case-record-v0.json",
  "title": "Atlas owner/evaluator case record with hidden adjudicated gold v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "visibility", "title", "competencies", "difficulty", "offer", "qualification_policy", "constraints", "prospects", "gold"],
  "properties": {
    "case_id": { "type": "string", "pattern": "^ATLAS-(DEV|SEALED)-[0-9]{3}$" },
    "visibility": { "enum": ["development", "sealed"] },
    "title": { "type": "string", "minLength": 8 },
    "competencies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "difficulty": { "enum": ["basic", "intermediate", "advanced", "adversarial"] },
    "offer": { "type": "object" },
    "qualification_policy": { "type": "object" },
    "constraints": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "prospects": { "type": "array", "minItems": 4, "maxItems": 12, "items": { "type": "object" } },
    "gold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labels", "ranked_tiers", "required_unknowns", "required_evidence", "actions", "critical_failures"],
      "properties": {
        "labels": { "type": "object", "minProperties": 4, "additionalProperties": { "enum": ["qualified", "needs_research", "disqualified"] } },
        "ranked_tiers": { "type": "array", "items": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^P[0-9]{1,2}$" } } },
        "required_unknowns": { "type": "object", "additionalProperties": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } },
        "required_evidence": { "type": "object", "additionalProperties": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^E[0-9]{1,2}$" } } },
        "actions": { "type": "object", "additionalProperties": { "enum": ["prioritize_outreach", "research_first", "exclude"] } },
        "critical_failures": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 5 } }
      }
    }
  }
}
